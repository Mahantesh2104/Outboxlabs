# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_outbox_jwt_key_change_in_prod
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/outbox_scheduler

# Redis Configuration (Required for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ethereal Email (Fake SMTP) Configuration
# Leave blank to auto-generate an Ethereal test account on startup,
# OR run `npm run generate-ethereal` to generate and populate permanent credentials.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
SENDER_NAME=Outbox Scheduler
SENDER_EMAIL=scheduler@outbox.example.com

# Rate Limiting & Worker Concurrency Configuration
# Number of emails processed in parallel by a worker instance
WORKER_CONCURRENCY=5
# Maximum number of emails BullMQ worker is allowed to send within RATE_LIMIT_WINDOW_MS
RATE_LIMIT_MAX=10
# Time window in milliseconds for BullMQ rate limiting (e.g., 60000 = 10 emails per minute)
RATE_LIMIT_WINDOW_MS=60000
# Minimum delay in milliseconds between individual email sends to prevent SMTP throttling
MIN_SEND_DELAY_MS=500
# API Rate Limit (max API requests per 15 minutes per IP)
API_RATE_LIMIT_MAX=200
